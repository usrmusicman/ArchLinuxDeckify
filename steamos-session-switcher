#!/usr/bin/env bash

# Check if an argument was provided
if [[ -z "$1" ]]; then
    echo "Usage: $0 /path/to/binary"
    exit 1
fi

TARGET_BIN="$1"

# 1. Write the target binary to a temp file for the TTY session to read
echo "$TARGET_BIN" > /tmp/game_session_target

# 2. Force the switch to TTY6 and start a login shell
# The login shell will trigger the logic in .bash_profile
sudo /usr/bin/openvt -c 6 -s -f -- /bin/bash -l
