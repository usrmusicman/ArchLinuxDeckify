#!/usr/bin/env bash

# Check if an argument was provided
if [[ -z "$1" ]]; then
    echo "Usage: $0 /path/to/binary"
    exit 1
fi

TARGET_BIN="$1"
REAL_USER=$(whoami)

# 1. Write the target binary to a temp file for the TTY session to read
echo "$TARGET_BIN" > /tmp/game_session_target

# 2. Unmask Getty TTY6 service
sudo /usr/bin/systemctl unmask getty@tty6.service

# 3. Force the switch to TTY6 and start a login shell
# The login shell will trigger the logic in .bash_profile
sudo /usr/bin/openvt -c 6 -s -f -u "$REAL_USER" -- /bin/bash -l

# 4. Mask Getty TTY6 service
sudo /usr/bin/systemctl mask getty@tty6.service
