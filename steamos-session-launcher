#!/usr/bin/env bash

# ==============================================================================
# UNIFIED STEAMOS SESSION SCRIPT (2026 HIGH-PERFORMANCE EDITION)
# ==============================================================================
# This script manages GPU-specific environment variables, compositor settings,
# and session launching. It uses a modular architecture to share core logic
# between driver variations (e.g., NVIDIA Proprietary vs. NVIDIA Hybrid).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. INITIALIZATION & ARGUMENT PARSING
# ------------------------------------------------------------------------------

# Clear the screen
clear

# Check if TERM variable is empty and then set it.
if [[ -z "$TERM" || "$TERM" == "unknown" ]]; then
    export TERM=linux
fi

# Path for SteamOS specific session configurations for Deck users
STEAMOS_SESSION_CONFIG="/home/$USER/.config/steamos-session/steamos-session-config"

# Load session config if available; otherwise, the script uses the hardcoded defaults below
if [[ -f "$STEAMOS_SESSION_CONFIG" ]]; then
    source "$STEAMOS_SESSION_CONFIG"
else
    echo -e "${YLW}WARNING: Session config not found, using built-in defaults${NC}"
fi

# SteamOS Icon Path
STEAMOS_ICON="/opt/steamos-session/assets/icons/steamos-session-icon.png"

# Define Steam-specific command flags
# We only use this if SESSION_BINARY ends up being steam
STEAMOS_FLAGS="-gamepadui -steamos3 -steamos -steamdeck"

# ------------------------------------------------------------------------------
# 2. EXECUTION LOGIC (SYSTEM GPU SWITCH)
# ------------------------------------------------------------------------------

# Show the SteamOS image in the tty terminal
echo ""
catimg $STEAMOS_ICON
echo ""

# Sleep for 3 seconds before starting Steam
sleep 3

# ------------------------------------------------------------------------------
# 3. GAMESCOPE COMPOSITOR SETUP
# ------------------------------------------------------------------------------

# Fallback defaults (prevents Gamescope crash if configs are missing or paths are broken)
: "${RENDER_WIDTH:=1280}"
: "${RENDER_HEIGHT:=720}"
: "${SCREENWIDTH:=1280}"
: "${SCREENHEIGHT:=720}"
: "${REFRESHRATE:=60}"

# Using an array to handle arguments cleanly without quoting issues.
GS_ARGS=(
  "-w" "$RENDER_WIDTH"      # Virtual width game sees
  "-h" "$RENDER_HEIGHT"     # Virtual height game sees
  "-W" "$SCREENWIDTH"       # Actual physical width
  "-H" "$SCREENHEIGHT"      # Actual physical height
  "-r" "$REFRESHRATE"       # Monitor Hz
  "-f"                      # Fullscreen
  "--adaptive-sync"         # VRR/G-Sync/FreeSync
  "--immediate-flips"       # Lowest possible latency (Tearing allowed if out of VRR)
  "--force-grab-cursor"     # Prevent mouse escaping the game window
  "--grab"                  # Prevent mouse escaping the game window
  "--mangoapp"              # Performance overlay support
  "--steam"                 # Integration with Steam UI
  "--xwayland-count" "2"    # Spin up multiple Xwayland instances
)

# ------------------------------------------------------------------------------
# 4. FINAL LAUNCH (TTY WAYLAND MODE)
# ------------------------------------------------------------------------------

# Force multiple xwayland sessions to fix bugs
export STEAM_MULTIPLE_XWAYLANDS=1

# Force the application to use Wayland backends
export SDL_VIDEODRIVER=wayland
export _JAVA_AWT_WM_NONREPARENTING=1
export QT_QPA_PLATFORM=wayland
export GDK_BACKEND=wayland
export XDG_CURRENT_DESKTOP=gamescope
export XDG_SESSION_TYPE=wayland

# Steam still requires XWayland for many web-views and older games,
# so we keep it for Steam.
gamescope "${GS_ARGS[@]}" -- /usr/bin/steam $STEAMOS_FLAGS 2>/dev/null
