#!/usr/bin/env bash
set -euo pipefail

clear

if [[ -z "${TERM:-}" || "$TERM" == "unknown" ]]; then
    export TERM=linux
fi

STEAMOS_SESSION_CONFIG="$HOME/.config/steamos-session/steamos-session-config"

if [[ -f "$STEAMOS_SESSION_CONFIG" ]]; then
    source "$STEAMOS_SESSION_CONFIG"
else
    echo "WARNING: Session config not found at '$STEAMOS_SESSION_CONFIG', using built-in defaults" >&2
fi

# Resolve Steam executable binary path (Native system binary -> Flatpak fallback)
STEAM_CMD=()
if command -v steam &>/dev/null; then
    STEAM_CMD=("$(command -v steam)")
elif flatpak info com.valvesoftware.Steam &>/dev/null; then
    STEAM_CMD=("flatpak" "run" "com.valvesoftware.Steam")
else
    echo "Error: Steam is not installed via system package or Flatpak." >&2
    exit 1
fi

# Ensure Gamescope compositor exists in PATH
if ! command -v gamescope &>/dev/null; then
    echo "Error: 'gamescope' binary was not found in PATH." >&2
    exit 1
fi

STEAMOS_SELECT="/usr/local/bin/steamos-session/steamos-session-select"
STEAMOS_LINK="$HOME/.local/bin/steamos-session-select"
STEAMOS_ICON="/opt/steamos-session/assets/icons/steamos-session-icon.png"

if [[ -f "$STEAMOS_SELECT" ]]; then
    mkdir -p "$(dirname "$STEAMOS_LINK")"
    ln -sf "$STEAMOS_SELECT" "$STEAMOS_LINK"
    cat2img
fi

sleep 1

# Fallback parameter defaults
: "${RENDER_WIDTH:=1280}"
: "${RENDER_HEIGHT:=720}"
: "${SCREENWIDTH:=1280}"
: "${SCREENHEIGHT:=720}"
: "${REFRESHRATE:=60}"
: "${ENABLE_HDR:=0}"
: "${HDR_SDR:=300}"
: "${HDR_TONEMAP:=100}"
: "${HDR_MAX:=800}"

STEAMOS_FLAGS=("-gamepadui" "-steamos3" "-steamos" "-steamdeck")

GS_ARGS=(
  "-w" "$RENDER_WIDTH"
  "-h" "$RENDER_HEIGHT"
  "-W" "$SCREENWIDTH"
  "-H" "$SCREENHEIGHT"
  "-r" "$REFRESHRATE"
  "-f"
  "--adaptive-sync"
  "--immediate-flips"
  "--force-grab-cursor"
  "--grab"
  "--mangoapp"
  "--steam"
  "--xwayland-count" "2"
)

HDR_ARGS=(
  "--hdr-enabled"
  "--hdr-sdr-content-nits=$HDR_SDR"
  "--hdr-itm-sdr-nits=$HDR_TONEMAP"
  "--hdr-itm-target-nits=$HDR_MAX"
)

# Mount all devices
udiskie -a

# Run multiple Xwayland instances
export STEAM_MULTIPLE_XWAYLANDS=1

# Run commands in gamescope
if [[ "$ENABLE_HDR" == "0" ]]; then
    exec gamescope "${GS_ARGS[@]}" -- "${STEAM_CMD[@]}" "${STEAMOS_FLAGS[@]}"
elif [[ "$ENABLE_HDR" == "1" ]]; then
    exec gamescope "${GS_ARGS[@]}" "${HDR_ARGS[@]}" -- "${STEAM_CMD[@]}" "${STEAMOS_FLAGS[@]}"
else
    echo "Error: Invalid ENABLE_HDR value '$ENABLE_HDR'. Must be 0 or 1." >&2
    exit 1
fi
