#!/usr/bin/env bash
# NO execution, NO sourcing of launchers

# ------------------------------------------------
# MONITOR & UPSCALING & POWER & RTIRQ PRIO & PIPEWIRE AUDIO SESSION SETTINGS
# ------------------------------------------------

# Target Monitor (Output)
export SCREENWIDTH=1920
export SCREENHEIGHT=1080
export REFRESHRATE=360

# Internal Render Resolution (The "Game" resolution)
# Example: Set to 1920x1080 to upscale to 1440p
export RENDER_WIDTH=1920
export RENDER_HEIGHT=1080

# ------------------------------------------------
# Hardware Specific Toggles
# ------------------------------------------------

export __GL_MaxFramesAllowed=1
export __GL_GSYNC_ALLOWED=1
export __GL_SHADER_DISK_CACHE=1
export __GL_SHADER_DISK_CACHE_PATH="$HOME/.cache/nvidia"
export __GL_VRR_ALLOWED=1
export __GL_WRITE_COMBINED_MEMORY=1
export __GL_YIELD="USLEEP"
export __GLX_VENDOR_LIBRARY_NAME=nvidia
export __VK_LAYER_NV_optimus=NVIDIA_only
export __NV_PRIME_RENDER_OFFLOAD=1
export __NV_PRIME_RENDER_OFFLOAD_TRUSTED=1
export GBM_BACKEND=nvidia-drm
export PROTON_ENABLE_NVAPI=1
export PROTON_HIDE_NVIDIA_GPU=0
export PROTON_NVIDIA_LIBS_NO_32BIT=1
export WLR_DRM_NO_ATOMIC=1
export WLR_NO_HARDWARE_CURSORS=1

# ------------------------------------------------
# Gamemode Enhanced Settings
# ------------------------------------------------

# Set IRQ threads up to a value 97 is acceptable
export RT_PRIO_USB=90
export RT_PRIO_PIPEWIRE=85
export RT_PRIO_BT=80
export RT_PRIO_SOUND=70

# ------------------------------------------------
# Common Proton / Gamescope / Steam defaults
# ------------------------------------------------

# Wayland + Gamescope
export ENABLE_GAMESCOPE_WSI=1

# HDR
export PROTON_ENABLE_HDR=1
export DXVK_HDR=1
export ENABLE_HDR_WSI=1

# Frame pacing / VRR
export vblank_mode=0
export MESA_VK_WSI_PRESENT_MODE=mailbox

# DX12
export VKD3D_CONFIG=dxr

# [GLOBAL]: Pure 64-bit environment for 2026 performance.
# This eliminates 32-bit thunking overhead for modern titles.
# NOTE: If EAC (Easy Anti-Cheat) titles fail, comment this out.
export PROTON_USE_WOW64=1

# Enable the use of the new WINENTSYNC implementation to reduce loading and streaming overhead
export WINENTSYNC=1

# ------------------------------------------------
# Font Text Colors
# ------------------------------------------------
export BLUE='\033[1;34m'
export GREEN='\033[1;32m'
export RED='\033[1;31m'
export YELLOW='\033[1;33m'
export TEAL='\033[1;36m'
export MAGENTA='\033[1;35m' # Fixed typo
export WHITE='\033[0m'
export NC='\033[0m'         # Added No Color

# ------------------------------------------------
# Misc
# ------------------------------------------------
export STEAM_GAMESCOPE_HAS_HDR=1
export STEAM_USE_ANY_CONFIG=1
export XDG_RUNTIME_DIR=/run/user/$(id -u)

# ------------------------------------------------
# Debugging
# ------------------------------------------------
# Only log if we haven't already logged in this process tree
if [ -z "$ENV_LOGGED" ]; then
    export -p > "$HOME/steamos-session-env.log"
    export ENV_LOGGED=1
fi

# ------------------------------------------------
# Welcome Message
# ------------------------------------------------
echo -e "${TEAL}Starting steam with Nvidia Hybrid GPU optimizations...${NC}"
