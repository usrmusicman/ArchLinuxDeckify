#!/usr/bin/env bash
# NO execution, NO sourcing of launchers

# ------------------------------------------------
# MONITOR & UPSCALING & POWER & RTIRQ PRIO & PIPEWIRE AUDIO SESSION SETTINGS
# ------------------------------------------------

# Target Monitor (Output)
export SCREENWIDTH=1920
export SCREENHEIGHT=1080
export REFRESHRATE=144

# Internal Render Resolution (The "Game" resolution)
# Example: Set to 1920x1080 to upscale to 1440p
export RENDER_WIDTH=1920
export RENDER_HEIGHT=1080

# ------------------------------------------------
# Hardware Specific Toggles
# ------------------------------------------------

export MESA_LOADER_DRIVER_OVERRIDE=nouveau
export NOUVEAU_MESA_DEBUG=1
export NVK_DEBUG=sync
export NVK_PERFTEST=gpl,nggc,sam,rt
export mesa_glthread=true

# ------------------------------------------------
# IRQ Settings
# ------------------------------------------------

# Set IRQ threads up to a value 97 is acceptable
export RT_PRIO_USB=95
export RT_PRIO_SOUND=90
export RT_PRIO_PIPEWIRE=85

# ------------------------------------------------
# Common Proton / Gamescope / Steam defaults
# ------------------------------------------------

# Wayland + Gamescope
export ENABLE_GAMESCOPE_WSI=1

# HDR
export PROTON_ENABLE_HDR=1
export DXVK_HDR=1
export ENABLE_HDR_WSI=1

# Frame pacing / VRR
export vblank_mode=0
export MESA_VK_WSI_PRESENT_MODE=mailbox

# DX12
export VKD3D_CONFIG=dxr

# Enable the use of the new WINENTSYNC implementation to reduce loading and streaming overhead
export WINENTSYNC=1

# ------------------------------------------------
# Experimental Features (Uncomment)
# ------------------------------------------------

# DX12 / VKD3D Low-Latency Settings
#export PROTON_VKD3D_LOWLATENCY=1
#export VKD3D_LOW_LATENCY_OFFSET=200
#export VKD3D_FRAME_RATE=140

# DX9/10/11 / DXVK Low-Latency Settings
#export PROTON_DXVK_LOWLATENCY=1
#export DXVK_FRAME_PACE="low-latency-vrr-144"

# Pure 64-bit environment for 2026 performance
#export PROTON_USE_WOW64=1

# ------------------------------------------------
# Font Text Colors
# ------------------------------------------------
export BLUE='\033[1;34m'
export GREEN='\033[1;32m'
export RED='\033[1;31m'
export YELLOW='\033[1;33m'
export TEAL='\033[1;36m'
export MAGENTA='\033[1;35m' # Fixed typo
export WHITE='\033[0m'
export NC='\033[0m'         # Added No Color

# ------------------------------------------------
# Misc
# ------------------------------------------------
export STEAM_GAMESCOPE_HAS_HDR=1
export STEAM_USE_ANY_CONFIG=1
export XDG_RUNTIME_DIR=/run/user/$(id -u)

# ------------------------------------------------
# Debugging
# ------------------------------------------------
# Only log if we haven't already logged in this process tree
if [ -z "$ENV_LOGGED" ]; then
    export -p > "$HOME/steamos-session-env.log"
    export ENV_LOGGED=1
fi

# ------------------------------------------------
# Welcome Message
# ------------------------------------------------
echo -e "${YELLOW}Starting steam with Nvidia FOSS GPU drivers and nouveau optimizations...${NC}"
