#
# ~/.bash_profile
#

[[ -f ~/.bashrc ]] && . ~/.bashrc

# ~/.bash_profile   (or append to ~/.profile if you use that instead)

# ------------------------------------------------
# Experimental Features
# ------------------------------------------------

# rusticl specific
#export RUSTICL_ENABLE=nvk  # 'iris' for Intel / 'radeonsi' for AMD / "nvk" for Nvidia using nvk+nouveau
#export OCL_ICD_VENDORS=rusticl.icd

# ------------------------------------------------
# SteamOS Session Launchers
# ------------------------------------------------
export STEAMOS_SESSION_PATH="$HOME/.local/bin/steamos-session"
export STEAMOS_SESSION_IMMUTABLE_COMPAT="$STEAMOS_SESSION_PATH/steamos-session-immutable-bootstrap"
export STEAMOS_GAMEMODE="$STEAMOS_SESSION_PATH/steamos-gamemode-enhanced"
export STEAMOS_SESSION_LAUNCHER="$STEAMOS_SESSION_PATH/steamos-session-launcher"
export DESKTOP_AUTOLOGIN="startplasma-wayland"

# Session Logic
if [ "$(tty)" = "/dev/tty1" ]; then
    sudo $STEAMOS_SESSION_IMMUTABLE_COMPAT
    udiskie-mount -a
    clear
    sudo $STEAMOS_GAMEMODE -s lavd -m gaming
    clear
    $STEAMOS_SESSION_LAUNCHER
    clear
    sudo $STEAMOS_GAMEMODE -x
    clear
    $DESKTOP_AUTOLOGIN
    clear
    exit
fi
