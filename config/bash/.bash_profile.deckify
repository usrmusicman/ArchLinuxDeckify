#
# ~/.bash_profile
#

[[ -f ~/.bashrc ]] && . ~/.bashrc

# ~/.bash_profile   (or append to ~/.profile if you use that instead)

# ------------------------------------------------
# Active Hardware & Resolution Profiles
# ------------------------------------------------
# Hardware profiles: e.g., "amdgpu-valve-steamdeck", "nvidia-acer-nitrov15", "xe-a770"
export OEM_HARDWARE_PROFILE="amdgpu-valve-steamdeck"

# Driver variant: 0 = nouveau (open-source), 1 = proprietary nvidia
export NVIDIA_OFFICIAL="1"

# Resolution profile: e.g., "1440p-144", "4k-60", "800p-60"
export RESOLUTION_TARGET="1440p-144"

# ------------------------------------------------
# SteamOS Session Launchers
# ------------------------------------------------
export STEAMOS_GAMEMODE="/opt/steamos-session/steamos-gamemode-enhanced"
export STEAMOS_SESSION_LAUNCHER="/opt/steamos-session/steamos-session-launcher"
export DESKTOP_AUTOLOGIN="startplasma-wayland"

# Session Logic
if [ "$(tty)" = "/dev/tty1" ]; then
    udiskie-mount -a
    clear
    $STEAMOS_SESSION_LAUNCHER
    clear
    unset SESSION_BINARY
    clear
    $DESKTOP_AUTOLOGIN
    clear
    exit
fi
