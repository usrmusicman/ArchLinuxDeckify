#!/bin/env bash

BASEDIR="/opt/steamos-session"

# Set default directory for HARDWARE_CONFIG if not already set by the environment
HARDWARE_CONFIG="${HARDWARE_CONFIG:-${BASEDIR}/config/session/hardware}"

# If no arguments are provided (e.g., clicked from a file manager), default to --config --gui
if [[ $# -eq 0 ]]; then
    set -- "--config" "--gui"
fi

if [[ "$1" == "--deckify" ]]; then
    cp ${BASEDIR}/config/bash/.bash_profile.deckify ${HOME}/.bash_profile
    if [[ -x "/usr/bin/plasmalogin" ]]; then
        sudo systemctl mask plasmalogin.service
        sudo systemctl unmask getty@tty1.service
        systemctl reboot
    elif [[ -x "/usr/bin/gdm" ]]; then
        sudo systemctl mask gdm.service
        sudo systemctl unmask getty@tty1.service
        systemctl reboot
    elif [[ -x "/usr/bin/lightdm" ]]; then
        sudo systemctl mask lightdm.service
        sudo systemctl unmask getty@tty1.service
        systemctl reboot
    elif [[ -x "/usr/bin/sddm" ]]; then
        sudo systemctl mask sddm.service
        sudo systemctl unmask getty@tty1.service
        systemctl reboot
    else
        echo -e "Display session manager not supported"
    fi
elif [[ "$1" == "--normal" ]]; then
    cp ${BASEDIR}/config/bash/.bash_profile.normal ${HOME}/.bash_profile
    if [[ -x "/usr/bin/plasmalogin" ]]; then
        sudo systemctl unmask plasmalogin.service
        sudo systemctl mask getty@tty1.service
        systemctl reboot
    elif [[ -x "/usr/bin/gdm" ]]; then
        sudo systemctl unmask gdm.service
        sudo systemctl mask getty@tty1.service
        systemctl reboot
    elif [[ -x "/usr/bin/lightdm" ]]; then
        sudo systemctl unmask lightdm.service
        sudo systemctl mask getty@tty1.service
        systemctl reboot
    elif [[ -x "/usr/bin/sddm" ]]; then
        sudo systemctl unmask sddm.service
        sudo systemctl mask getty@tty1.service
        systemctl reboot
    else
        echo -e "Display session manager not supported"
    fi
elif [[ "$1" == "--config" ]]; then
    # 1. Require either --cli or --gui
    if [[ "$2" == "--cli" ]]; then
        # Check if a configuration argument was provided
        if [[ -z "$3" ]]; then
            # If given no argument, then and ONLY then list the configurations recursively
            echo -e "Available configurations under ${HARDWARE_CONFIG}:"
            echo -e "--------------------------------------------------"

            if [[ -d "${HARDWARE_CONFIG}" ]]; then
                # Recursively find all files, filtering only those with a bash shebang
                find "${HARDWARE_CONFIG}" -type f -print0 | while IFS= read -r -d '' file; do
                    if head -n 1 "$file" | grep -q "bash"; then
                        echo -e "Config: $(basename "$file")"
                        echo -e "Path:   $file"
                        echo -e "--------------------------------------------------"
                    fi
                done
            else
                echo -e "Error: Directory ${HARDWARE_CONFIG} does not exist."
                exit 1
            fi
            exit 0
        fi
        # If an argument is given, treat $3 as the whole path
        CONFIG_PATH="$3"

    elif [[ "$2" == "--gui" ]]; then
        # GUI file selection logic: try kdialog first, fallback to zenity
        if command -v kdialog &> /dev/null; then
            CONFIG_PATH=$(kdialog --title "Select Hardware Profile" --getopenfilename "${HARDWARE_CONFIG}")
        elif command -v zenity &> /dev/null; then
            CONFIG_PATH=$(zenity --file-selection --title="Select Hardware Profile" --filename="${HARDWARE_CONFIG}/")
        else
            echo -e "Error: Neither kdialog nor zenity is installed. Cannot launch GUI."
            exit 1
        fi

        # Handle the case where the user cancels the file picker prompt or empty input is returned
        if [[ -z "${CONFIG_PATH}" ]]; then
            echo -e "File selection canceled. Exiting gracefully."
            exit 0
        fi
    else
        echo -e "Error: --config requires either --gui or --cli as an argument."
        exit 1
    fi

    # 2. Verify file existence at the specified full path
    if [[ ! -f "${CONFIG_PATH}" ]]; then
        echo -e "Error: Configuration file not found at '${CONFIG_PATH}'."
        exit 1
    fi

    # 3. Verify that the file is a bash script by checking the first line (shebang)
    if ! head -n 1 "${CONFIG_PATH}" | grep -q "bash"; then
        echo -e "Error: '${CONFIG_PATH}' is not a valid bash script (missing bash shebang)."
        exit 1
    fi

    # 4. Create destination directory if it doesn't exist
    DEST_DIR="${HOME}/.config/steamos-session"
    mkdir -p "${DEST_DIR}"

    # 5. Copy and overwrite the destination file
    DEST_PATH="${DEST_DIR}/steamos-session-config"
    cp -f "${CONFIG_PATH}" "${DEST_PATH}"

    echo -e "Success: Configuration copied to ${DEST_PATH}"

elif [[ "$1" == "--help" ]]; then
    echo -e "SteamOS Deckify Toggle"
    echo -e ""
    echo -e "--deckify: Toggle the steamdeck console setup"
    echo -e "--normal: Toggle normal install without the gamemode console boot sequence"
    echo -e "--config --cli [full_path]: Copy the chosen hardware profile path (leave empty to list configs)"
    echo -e "--config --gui: Launch a graphical file picker to choose the hardware profile path"
    echo -e "--help: Show this help message"
else
    echo -e "Please type in a valid option, use --help for more details"
fi
