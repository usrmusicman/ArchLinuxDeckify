#!/usr/bin/env bash
# Gamemode Enhanced + pw-jack Launcher
# Explicit GPU / USB / PipeWire Low-Latency Wrapper
# Author: Alexander Mcmillan <linuxguy93@gmail.com>

# --------------------------
# COLORS & UTILS
# --------------------------
YLW='\033[1;33m'; GRN='\033[1;32m'; CYN='\033[1;36m'; RED='\033[1;31m'; NC='\033[0m'
notify()  { echo -e "${YLW}[GAMEMODE-ENHANCED]${NC} $1"; }
confirm() { echo -e "            ↳ ${GRN}APPLIED:${NC} $1"; }

# --------------------------
# USER & CONFIG
# --------------------------

# Identify the actual user to handle XDG_RUNTIME and PipeWire socket paths correctly when run as sudo
REAL_USER=${SUDO_USER:-$USER}

# Path for SteamOS specific session configurations for Deck users
STEAMOS_SESSION_CONFIG="/home/$REAL_USER/.config/steamos-session/steamos-session-config"

# Load session config if available; otherwise, the script uses the hardcoded defaults below
if [[ -f "$STEAMOS_SESSION_CONFIG" ]]; then
    source "$STEAMOS_SESSION_CONFIG"
else
    echo -e "${YLW}WARNING: Session config not found, using built-in defaults${NC}"
fi

# --------------------------
# DEFAULTS
# --------------------------
GPU_SETUP=${GPU_SETUP:-generic}
RT_PRIO_USB=${RT_PRIO_USB:-90}       # Priority for USB host controllers (Controllers/Mice)
RT_PRIO_PIPEWIRE=${RT_PRIO_PIPEWIRE:-85} # Priority for PipeWire audio daemon
RT_PRIO_BT=${RT_PRIO_BT:-80}        # Priority for Bluetooth kernel threads
RT_PRIO_SOUND=${RT_PRIO_SOUND:-75}   # Priority for Sound Card hardware interrupts

# --------------------------
# SYSTEM STATUS MODULE (-i)
# --------------------------
display_status() {
    notify "Gathering Current System & Audio Status..."
    local user_uid=$(id -u "$REAL_USER")

    echo -e "\n${YLW}=== ENVIRONMENT ===${NC}"
    echo -e "${GRN}Active User:${NC} $REAL_USER (UID: $user_uid)"

    echo -e "\n${YLW}=== THREADED IRQs (Interrupt Requests) ===${NC}"
    echo -e "Displaying hardware interrupts sorted by Real-Time (RT) Priority:"
    echo -e "------------------------------------------------------------"
    printf "  %-10s | %-10s | %-30s\n" "PID" "RT PRIO" "COMMAND"
    echo -e "------------------------------------------------------------"

    # Fetch process list, filtering for hardware-critical threads
    ps -eo pid,rtprio,comm | grep -iE "^ *[0-9]+ +([0-9]+|-) +(irq/|xhci|nvme|snd|wireplumber|rtkit-daemon|bluetooth)" | sort -k2 -nr | head -n 25 | while read -r pid rtprio comm; do
        if [[ "$rtprio" != "-" ]]; then
            printf "  %-10s | %-10s | %-30s\n" "$pid" "$rtprio" "$comm"
        else
            # TS indicates Time Sharing (Standard priority)
            printf "  %-10s | %-10s | %-30s\n" "$pid" "0 (TS)" "$comm"
        fi
    done
    echo -e "------------------------------------------------------------\n"
    exit 0
}

# --------------------------
# CORE FUNCTIONS
# --------------------------

# Manage Kernel Sysctl Tunables for Gaming
manage_sysctl() {
    if [[ "$1" == "on" ]]; then
        # Apply performance tunables
        sysctl -q -w vm.swappiness=1
        sysctl -q -w vm.vfs_cache_pressure=50
        sysctl -q -w vm.max_map_count=1048576
        sysctl -q -w net.core.netdev_max_backlog=5000
        sysctl -q -w net.ipv4.tcp_fastopen=3
        sysctl -q -w kernel.sched_rt_runtime_us=-1
        sysctl -q -w kernel.numa_balancing=0
        sysctl -q -w vm.stat_interval=10
        sysctl -q -w kernel.timer_migration=0

        confirm "Sysctl -> Gamemode Enhanced profile applied"
    else
        # Revert to Arch Linux standard kernel/systemd defaults
        sysctl -q -w vm.swappiness=60
        sysctl -q -w vm.vfs_cache_pressure=100
        sysctl -q -w vm.max_map_count=1048576  # Modern systemd standard
        sysctl -q -w net.core.netdev_max_backlog=1000
        sysctl -q -w net.ipv4.tcp_fastopen=1
        sysctl -q -w kernel.sched_rt_runtime_us=950000
        sysctl -q -w kernel.numa_balancing=0
        sysctl -q -w vm.stat_interval=1
        sysctl -q -w kernel.timer_migration=1

        confirm "Sysctl -> Restored to Arch Linux defaults"
    fi
}

# Manage Transparent Hugepages (THP) - Disabling can reduce frame-time stuttering
manage_thp() {
    if [[ "$1" == "on" ]]; then
        echo never | tee /sys/kernel/mm/transparent_hugepage/enabled >/dev/null
        echo never | tee /sys/kernel/mm/transparent_hugepage/defrag >/dev/null
        confirm "THP -> Disabled (Optimized for gaming consistency)"
    else
        echo always | tee /sys/kernel/mm/transparent_hugepage/enabled >/dev/null
        confirm "THP -> Enabled (Default)"
    fi
}

# Toggle WiFi power management to ensure low latency for online gaming
manage_wifi() {
    local p_state=$([[ "$1" == "on" ]] && echo "off" || echo "on")
    for dev in $(iw dev | awk '$1=="Interface"{print $2}'); do
        iw dev "$dev" set power_save "$p_state" 2>/dev/null
    done
    confirm "WiFi Power Save -> $p_state"
}

manage_pipewire() {
    local sw_pids=$(pgrep -u "$REAL_USER" -x "pipewire|wireplumber|pipewire-pulse")

    # Boost Software Daemons (PipeWire Stack)
    if [[ "$1" == "on" ]]; then
        if [[ -n "$sw_pids" ]]; then
            for pid in $sw_pids; do
                chrt -f -p "$RT_PRIO_PIPEWIRE" "$pid" 2>/dev/null
            done
            confirm "Audio Stack -> Software RT Priority $RT_PRIO_PIPEWIRE Applied"
        fi
    else
        if [[ -n "$sw_pids" ]]; then
            for pid in $sw_pids; do
                chrt -o -p 0 "$pid" 2>/dev/null
            done
            confirm "Audio Stack -> Default Priority Restored"
        fi
    fi
}

manage_soundcards() {
    # Identify PIDs for Intel HDA and AMD ACP (onboard audio controllers)
    local sound_irqs=$(pgrep -f "irq/.*(snd_hda_intel|snd_acp)")

    if [[ "$1" == "on" ]]; then
        # Check if any PIDs were actually found to avoid empty loop errors
        if [[ -n "$sound_irqs" ]]; then
            for pid in $sound_irqs; do
                # Double-check: RT_PRIO_SOUND must be a non-empty integer > 0
                if [[ -n "$RT_PRIO_SOUND" && "$RT_PRIO_SOUND" -gt 0 ]]; then
                    # Force FIFO policy for Real-Time priority
                    chrt -f -p "$RT_PRIO_SOUND" "$pid" 2>/dev/null
                else
                    # Use OTHER policy for priority 0 (standard)
                    chrt -o -p 0 "$pid" 2>/dev/null
                fi
            done
            confirm "Onboard Sound -> RT Priority $RT_PRIO_SOUND Applied"
        fi
    else
        if [[ -n "$sound_irqs" ]]; then
            for pid in $sound_irqs; do
                chrt -o -p 0 "$pid" 2>/dev/null
            done
            confirm "Onboard Sound -> Default Priority Restored"
        fi
    fi
}

# Configure USB polling threads for Real-Time execution
manage_usb() {
    local pids=$(pgrep -f "xhci")

    if [[ "$1" == "on" ]]; then
        # Disable power autosuspend to prevent USB controller "sleep" latency
        echo -1 | tee /sys/module/usbcore/parameters/autosuspend >/dev/null
        # Apply SCHED_FIFO (Real-Time) to USB controllers
        for pid in $pids; do
            if [[ "$RT_PRIO_USB" -gt 0 ]]; then
                chrt -f -p "$RT_PRIO_USB" "$pid" 2>/dev/null
            else
                # If 0, reset to the default scheduling policy
                chrt -o -p 0 "$pid" 2>/dev/null
            fi
        done
        confirm "USB -> RT Priority $RT_PRIO_USB & Autosuspend -1"
    else
        echo 2 | tee /sys/module/usbcore/parameters/autosuspend >/dev/null
        for pid in $pids; do
            chrt -o -p 0 "$pid" 2>/dev/null
        done
        confirm "USB -> Default states restored"
    fi
}

# Set GPU to high-performance clocks
manage_gpu() {
    local action=$1
    case "$GPU_SETUP" in
        amd)
            if [[ "$action" == "on" ]]; then
                for dev in /sys/class/drm/card*/device/; do
                    [[ -f "${dev}power_dpm_force_performance_level" ]] && echo "high" | tee "${dev}power_dpm_force_performance_level" >/dev/null 2>&1
                done
                confirm "GPU (AMD) -> Performance Mode"
            else
                for dev in /sys/class/drm/card*/device/; do
                    [[ -f "${dev}power_dpm_force_performance_level" ]] && echo "auto" | tee "${dev}power_dpm_force_performance_level" >/dev/null 2>&1
                done
            fi
            ;;
        intel)
            if [[ "$action" == "on" ]]; then
                for dev in /sys/class/drm/card*/gt/gt*/; do
                    if [[ -f "${dev}rps_max_freq_mhz" && -f "${dev}rps_boost_freq_mhz" ]]; then
                        cat "${dev}rps_boost_freq_mhz" > "${dev}rps_max_freq_mhz" 2>/dev/null
                    fi
                done
                confirm "GPU (Intel) -> Performance Limits Uncapped"
            else
                for dev in /sys/class/drm/card*/gt/gt*/; do
                    if [[ -f "${dev}rps_RP0_freq_mhz" && -f "${dev}rps_max_freq_mhz" ]]; then
                        cat "${dev}rps_RP0_freq_mhz" > "${dev}rps_max_freq_mhz" 2>/dev/null
                    fi
                done
                confirm "GPU (Intel) -> Default Performance Defaults Restored"
            fi
            ;;
        nvidia)
            if [[ "$action" == "on" ]]; then
                nvidia-smi -pm 1 >/dev/null 2>&1
                runuser -u "$REAL_USER" -- nvidia-settings -a "[gpu:0]/GPUPowerMizerMode=1" >/dev/null 2>&1
                runuser -u "$REAL_USER" -- nvidia-settings -a "[gpu:1]/GPUPowerMizerMode=1" >/dev/null 2>&1
                confirm "GPU (NVIDIA) -> Performance Mode"
            else
                nvidia-smi -pm 0 >/dev/null 2>&1
                runuser -u "$REAL_USER" -- nvidia-settings -a "[gpu:0]/GPUPowerMizerMode=0" >/dev/null 2>&1
                runuser -u "$REAL_USER" -- nvidia-settings -a "[gpu:1]/GPUPowerMizerMode=0" >/dev/null 2>&1
                confirm "GPU (NVIDIA) -> Powersave Mode"
            fi
            ;;
    esac
}

# Manage eBPF custom schedulers (SCX)
start_scheduler() {
    local sched=${SCHED_NAME:-lavd}
    local mode=${SCHED_MODE:-lowlatency}

    if command -v scxctl &>/dev/null; then
        scxctl stop >/dev/null 2>&1
        sleep 0.2
        scxctl start --sched "$sched" --mode "$mode" &
        confirm "Scheduler -> $sched (Mode: $mode)"
    fi
}

# Restore system to standard operational state
revert_defaults() {
    notify "Restoring system defaults..."
    manage_sysctl off
    manage_wifi off
    manage_pipewire off
    manage_soundcards off
    manage_usb off
    manage_gpu off
    manage_thp off

    if command -v scxctl &>/dev/null; then
        scxctl stop >/dev/null 2>&1
        confirm "Scheduler -> Default Kernel CFS Restored"
    fi

    confirm "System defaults restored"
}

# --------------------------
# VERBOSE HELP FUNCTION (-h)
# --------------------------
show_help() {
    echo -e "${YLW}Linux Gamemode Enhanced (High-Performance Audio & Gaming Wrapper)${NC}"
    echo -e "----------------------------------------------------------------------"
    echo -e "This script forcibly overrides system parameters to prioritize low-latency"
    echo -e "audio processing, controller polling, and raw GPU performance. It interacts"
    echo -e "directly with hardware governors, process scheduling, and PipeWire APIs."

    echo -e "\n${GRN}USAGE:${NC} sudo $0 [OPTIONS]"

    echo -e "\n${CYN}CORE OPTIONS:${NC}"
    echo -e "  ${YLW}-s <scheduler>${NC} Injects a custom eBPF scheduler via SCX. Overrides the default"
    echo -e "                  CFS scheduler in the Linux Kernel. (Default: lavd)"
    echo -e "  ${YLW}-m <mode>${NC}      Applies a specific behavioral profile to the chosen SCX scheduler."
    echo -e "                  (Default: lowlatency)"
    echo -e "  ${YLW}-i${NC}              Displays current Audio settings, sample rates, and an"
    echo -e "                  active hardware Interrupt Request (IRQ) thread breakdown."
    echo -e "  ${YLW}-x${NC}              Restores all hardware governors, schedulers, and powersave states."
    echo -e "  ${YLW}-h${NC}              Shows this verbose help message."

    echo -e "\n${YLW}--- SCX Schedulers (eBPF) ---${NC}"
    echo -e "  * ${GRN}beerland${NC}   - High-throughput, heavy compilation/IO tasks."
    echo -e "  * ${GRN}bpfland${NC}    - Direct BPF, minimal scheduling overhead."
    echo -e "  * ${GRN}cosmos${NC}     - High-performance general-purpose."
    echo -e "  * ${GRN}flash${NC}      - Ultra-aggressive preemption. Maximum responsiveness, low efficiency."
    echo -e "  * ${GRN}lavd${NC}       - Latency-critical Auto-Vblank (Best for Audio)."
    echo -e "  * ${GRN}p2dq${NC}       - Power-aware Dual Queue (Balanced laptops)."
    echo -e "  * ${GRN}rustland${NC}   - High-safety BPF written in Rust."
    echo -e "  * ${GRN}rusty${NC}      - Efficient modern scheduler for highly interactive multicore desktop use."
    echo -e "  * ${GRN}tickless${NC}   - Reduced timer interrupts for CPU consistency."

    echo -e "\n${YLW}--- Supported Mode Profiles ---${NC}"
    echo -e "  * ${CYN}gaming${NC}      - Prioritizes foreground task vblank sync to prevent stutter."
    echo -e "  * ${CYN}lowlatency${NC}  - Favors absolute lowest scheduling delay for RT audio apps."
    echo -e "  * ${CYN}powersave${NC}   - Efficient, battery-friendly mode."
    echo -e "  * ${CYN}balanced${NC}    - Standard desktop responsiveness."

    echo -e "\n${YLW}--- GPU Setup Options (Editable in config) ---${NC}"
    echo -e "  * ${CYN}nvidia${NC}          - Dedicated NVIDIA GPU"
    echo -e "  * ${CYN}nvidia_hybrid${NC}   - NVIDIA + Integrated GPU (Hybrid)"
    echo -e "  * ${CYN}nvidia_nvk${NC}      - NVIDIA with FOSS driver (Nouveau)"
    echo -e "  * ${CYN}amd${NC}             - Dedicated AMD GPU"
    echo -e "  * ${CYN}intel${NC}           - Integrated Intel GPU"

    echo -e "\n${YLW}--- RT Priority Defaults (Editable in config) ---${NC}"
    echo -e "  USB       : ${CYN}$RT_PRIO_USB${NC}"
    echo -e "  Bluetooth : ${CYN}$RT_PRIO_BT${NC}"
    echo -e "  Sound IRQ : ${CYN}$RT_PRIO_SOUND${NC}"

    echo -e "----------------------------------------------------------------------"
    exit 0
}

# --------------------------
# MAIN EXECUTION
# --------------------------

# Privilege check
[[ $EUID -ne 0 ]] && { echo -e "${RED}ERROR: Run with sudo.${NC}"; exit 1; }

# This ensures that even if the script crashes or is killed, defaults return.
trap revert_defaults SIGINT SIGTERM

# Parse arguments
while getopts "s:m:q:r:l:ixh" opt; do
    case "$opt" in
        s) SCHED_NAME=$OPTARG ;;
        m) SCHED_MODE=$OPTARG ;;
        i) display_status ;;
        x) revert_defaults; exit 0 ;;
        h) show_help ;;
        *) show_help ;;
    esac
done

# Activating Overrides
notify "Engaging Performance Mode..."
manage_sysctl on
manage_thp on
manage_wifi on
manage_pipewire on
manage_soundcards on
manage_usb on
manage_gpu on
start_scheduler

notify "Performance Mode -> ACTIVE"
