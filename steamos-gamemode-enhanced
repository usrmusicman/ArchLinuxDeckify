#!/usr/bin/env bash
# Gamemode Enhanced
# Explicit GPU / USB / PipeWire Low-Latency Wrapper
# Author: Alexander Mcmillan <linuxguy93@gmail.com>

# --------------------------
# COLORS & UTILS
# --------------------------
YLW='\033[1;33m'; GRN='\033[1;32m'; CYN='\033[1;36m'; RED='\033[1;31m'; NC='\033[0m'
notify()  { echo -e "${YLW}[GAMEMODE-ENHANCED]${NC} $1"; }
confirm() { echo -e "           ↳ ${GRN}APPLIED:${NC} $1"; }

# --------------------------
# USER & CONFIG
# --------------------------

# User running sudo command
REAL_USER=${SUDO_USER:-$USER}

# SteamOS session config file
STEAMOS_SESSION_CONFIG="/home/$REAL_USER/.config/steamos-session/steamos-session-config"

# Load session config
if [[ -f "$STEAMOS_SESSION_CONFIG" ]]; then
    source "$STEAMOS_SESSION_CONFIG"
else
    echo -e "${YLW}WARNING: Session config not found, using built-in defaults${NC}"
fi

# --------------------------
# DEFAULTS (if not defined in config)
# --------------------------
GPU_SETUP=${GPU_SETUP:-generic}
RT_PRIO_USB=${RT_PRIO_USB:-90}
RT_PRIO_PIPEWIRE=${RT_PRIO_PIPEWIRE:-80}
RT_PRIO_BT=${RT_PRIO_BT:-85}
RT_PRIO_SOUND=${RT_PRIO_SOUND:-70}

# Pipewire Settings
DEFAULT_QUANTUM=${DEFAULT_QUANTUM:-256}
DEFAULT_RATE=${DEFAULT_RATE:-48000}

# --------------------------
# SYSTEM STATUS MODULE (-i)
# --------------------------
display_status() {
    notify "Gathering Current System & Audio Status..."
    local user_uid=$(id -u "$REAL_USER")

    echo -e "\n${YLW}=== AUDIO ENVIRONMENT ===${NC}"
    echo -e "${GRN}Active User:${NC} $REAL_USER (UID: $user_uid)"

    # Improved metadata extraction logic
    local pw_settings=$(runuser -u "$REAL_USER" -- env XDG_RUNTIME_DIR="/run/user/$user_uid" pw-metadata -n settings 0 2>/dev/null)

    # We use sed to grab only the digits/values following the key names
    local cur_quantum=$(echo "$pw_settings" | grep "clock.force-quantum" | sed -E 's/.*value:[[:space:]]*([^[:space:]]*).*/\1/' | tr -d "'")
    local cur_rate=$(echo "$pw_settings" | grep "clock.force-rate" | sed -E 's/.*value:[[:space:]]*([^[:space:]]*).*/\1/' | tr -d "'")

    # Check if values are 0 or empty (PipeWire's way of saying "Auto/Dynamic")
    [[ "$cur_quantum" == "0" || -z "$cur_quantum" ]] && cur_quantum="Dynamic (Auto)"
    [[ "$cur_rate" == "0" || -z "$cur_rate" ]] && cur_rate="Dynamic (Auto)"

    echo -e "  * Sample Rate : ${CYN}${cur_rate}${NC}"
    echo -e "  * Quantum Buf : ${CYN}${cur_quantum}${NC}"

    echo -e "\n${YLW}=== THREADED IRQs (Interrupt Requests) ===${NC}"
    echo -e "Displaying top hardware interrupts and audio threads sorted by RT Priority:"
    echo -e "------------------------------------------------------------"
    printf "  %-10s | %-10s | %-30s\n" "PID" "RT PRIO" "COMMAND"
    echo -e "------------------------------------------------------------"

    # Sorting by Priority (Column 2)
    ps -eo pid,rtprio,comm | grep -iE "^ *[0-9]+ +([0-9]+|-) +(irq/|xhci|nvme|snd|pipewire|wireplumber|rtkit-daemon|bluetooth)" | sort -k2 -nr | head -n 25 | while read -r pid rtprio comm; do
        if [[ "$rtprio" != "-" ]]; then
            printf "  %-10s | %-10s | %-30s\n" "$pid" "$rtprio" "$comm"
        else
            # Display non-RT threads with a "0" for visual alignment
            printf "  %-10s | %-10s | %-30s\n" "$pid" "0 (TS)" "$comm"
        fi
    done
    echo -e "------------------------------------------------------------\n"
    exit 0
}

# --------------------------
# CORE FUNCTIONS
# --------------------------

# Transparent Hugepages
manage_thp() {
    if [[ "$1" == "on" ]]; then
        echo never | tee /sys/kernel/mm/transparent_hugepage/enabled >/dev/null
        echo never | tee /sys/kernel/mm/transparent_hugepage/defrag >/dev/null
        confirm "Transparent Hugepages -> never"
    else
        echo always | tee /sys/kernel/mm/transparent_hugepage/enabled >/dev/null
        echo always | tee /sys/kernel/mm/transparent_hugepage/defrag >/dev/null
        confirm "Transparent Hugepages -> default"
    fi
}

# CPU governor & swappiness
manage_cpu() {
    if [[ "$1" == "on" ]]; then
        for cpu in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
            echo "performance" | tee "$cpu" >/dev/null 2>&1
        done
        for epp in /sys/devices/system/cpu/cpu*/cpufreq/energy_performance_preference; do
            [[ -f "$epp" ]] && echo "performance" | tee "$epp" >/dev/null
        done
        echo "10" | tee /proc/sys/vm/swappiness >/dev/null
        confirm "CPU Governor -> performance"
    else
        for cpu in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
            echo "schedutil" | tee "$cpu" >/dev/null 2>&1 || echo "powersave" | tee "$cpu" >/dev/null 2>&1
        done
        echo "60" | tee /proc/sys/vm/swappiness >/dev/null
        confirm "CPU Governor -> default"
    fi
}

# WiFi power save
manage_wifi() {
    local p_state=$([[ "$1" == "on" ]] && echo "off" || echo "on")
    for dev in $(iw dev | awk '$1=="Interface"{print $2}'); do
        iw dev "$dev" set power_save "$p_state" 2>/dev/null
    done
    confirm "WiFi Power Save -> $p_state"
}

# USB threads
manage_usb() {
    local pids=$(pgrep -f "xhci")
    if [[ "$1" == "on" ]]; then
        echo -1 | tee /sys/module/usbcore/parameters/autosuspend >/dev/null
        for pid in $pids; do chrt -f -p $RT_PRIO_USB "$pid"; done
        confirm "USB Threads -> autosuspend -1 & RT Priority $RT_PRIO_USB applied"
    else
        echo 2 | tee /sys/module/usbcore/parameters/autosuspend >/dev/null
        for pid in $pids; do chrt -o -p 0 "$pid"; done
        confirm "USB Threads -> default"
    fi
}

# PipeWire threads & Hardware Sound IRQ priority
manage_pipewire() {
    local pw_pids=$(pgrep -x "pipewire")
    # Identify IRQs for Intel (snd_hda_intel) and AMD (snd_hda_intel or acp)
    local sound_irqs=$(pgrep -f "snd_hda_intel|snd_acp")

    if [[ "$1" == "on" ]]; then
        # Boost PipeWire userspace threads
        for pid in $pw_pids; do
            chrt -f -p $RT_PRIO_PIPEWIRE "$pid"
        done

        # Boost Hardware Sound Card Interrupts
        for pid in $sound_irqs; do
            chrt -f -p $RT_PRIO_SOUND "$pid"
        done

        confirm "Audio Stack -> PipeWire RT: $RT_PRIO_PIPEWIRE | Sound IRQ RT: $RT_PRIO_SOUND"
    else
        # Revert PipeWire userspace
        for pid in $pw_pids; do
            chrt -o -p 0 "$pid"
        done

        # Revert Hardware Sound IRQs
        for pid in $sound_irqs; do
            chrt -o -p 0 "$pid"
        done

        confirm "Audio Stack -> default priority"
    fi
}

# GPU performance
manage_gpu() {
    local action=$1
    case "$GPU_SETUP" in
        nvidia|nvidia_hybrid)
            local gpu_index=0
            [[ "$GPU_SETUP" == "nvidia_hybrid" ]] && gpu_index=1
            if [[ "$action" == "on" ]]; then
                nvidia-smi -pm 1 >/dev/null 2>&1
                runuser -u "$REAL_USER" -- nvidia-settings -a "[gpu:$gpu_index]/GPUPowerMizerMode=1" >/dev/null 2>&1
                confirm "GPU NVIDIA gpu:$gpu_index (Maximum Performance)"
            else
                runuser -u "$REAL_USER" -- nvidia-settings -a "[gpu:$gpu_index]/GPUPowerMizerMode=0" >/dev/null 2>&1
                nvidia-smi -pm 0 >/dev/null 2>&1
                confirm "GPU NVIDIA gpu:$gpu_index (Default)"
            fi
            ;;
        nvidia_nvk)
            if [[ "$action" == "on" ]]; then
                echo high | tee /sys/class/drm/card1/device/power_dpm_force_performance_level >/dev/null 2>&1
                confirm "GPU (Nouveau) -> High Performance"
            else
                echo auto | tee /sys/class/drm/card1/device/power_dpm_force_performance_level >/dev/null 2>&1
                confirm "GPU (Nouveau) -> Default"
            fi
            ;;
        amd)
            if [[ "$action" == "on" ]]; then
                for dev in /sys/class/drm/card*/device/; do
                    [[ -f "${dev}power_dpm_force_performance_level" ]] && echo "high" | tee "${dev}power_dpm_force_performance_level" >/dev/null 2>&1
                    [[ -f "${dev}pp_power_profile_mode" ]] && echo "1" | tee "${dev}pp_power_profile_mode" >/dev/null 2>&1
                done
                confirm "GPU (AMD) -> High Performance"
            else
                for dev in /sys/class/drm/card*/device/; do
                    [[ -f "${dev}power_dpm_force_performance_level" ]] && echo "auto" | tee "${dev}power_dpm_force_performance_level" >/dev/null 2>&1
                    [[ -f "${dev}pp_power_profile_mode" ]] && echo "0" | tee "${dev}pp_power_profile_mode" >/dev/null 2>&1
                done
                confirm "GPU (AMD) -> Default"
            fi
            ;;
        intel)
            for dev in /sys/class/drm/card*/device/gt/gt*/freq0/; do
                if [[ -d "$dev" ]]; then
                    if [[ "$action" == "on" ]]; then
                        max_f=$(cat "${dev}rp0_freq_mhz" 2>/dev/null || cat "${dev}max_freq_mhz" 2>/dev/null)
                        [[ -n "$max_f" ]] && echo "$max_f" | tee "${dev}min_freq_mhz" >/dev/null 2>&1
                        confirm "GPU (Intel) -> Locked Max (${max_f}MHz)"
                    else
                        min_f=$(cat "${dev}rpn_freq_mhz" 2>/dev/null || echo "300")
                        echo "$min_f" | tee "${dev}min_freq_mhz" >/dev/null 2>&1
                        confirm "GPU (Intel) -> Dynamic (Default)"
                    fi
                fi
            done
            ;;
        *)
            echo -e "${RED}Unknown GPU_SETUP value: $GPU_SETUP${NC}"
            ;;
    esac
}

# Bluetooth
manage_bluetooth() {
    local hci="/sys/kernel/debug/bluetooth/hci0"
    local pids=$(pgrep -x "bluetoothd")
    if [[ "$1" == "on" ]]; then
        if [[ -d "$hci" ]]; then
            echo 12 | tee "$hci/conn_max_interval" >/dev/null 2>&1
            echo 6  | tee "$hci/conn_min_interval" >/dev/null 2>&1
        fi
        for pid in $pids; do chrt -f -p $RT_PRIO_BT "$pid"; done
        confirm "Bluetooth -> Low Latency Polling & RT Priority $RT_PRIO_BT"
    else
        for pid in $pids; do chrt -o -p 0 "$pid"; done
        confirm "Bluetooth -> default"
    fi
}

# PipeWire Restarter & Buffer Manager
set_pipewire_audio() {
    local quantum=${1:-$DEFAULT_QUANTUM}
    local rate=${2:-$DEFAULT_RATE}
    local user_uid=$(id -u "$REAL_USER")

    notify "Executing PipeWire subsystem restart for user: $REAL_USER..."

    # We must explicitly define the user's runtime directory so systemctl user daemon commands don't fail as root.
    runuser -u "$REAL_USER" -- env XDG_RUNTIME_DIR="/run/user/$user_uid" systemctl --user restart pipewire pipewire-pulse wireplumber >/dev/null 2>&1
    confirm "PipeWire, Pulse, and WirePlumber services restarted"

    # Allow services 2 seconds to rebuild their graph before injecting metadata overrides
    sleep 2

    runuser -u "$REAL_USER" -- env XDG_RUNTIME_DIR="/run/user/$user_uid" pw-metadata -n settings 0 clock.force-quantum "$quantum" >/dev/null 2>&1
    confirm "PipeWire Target Quantum -> $quantum"

    runuser -u "$REAL_USER" -- env XDG_RUNTIME_DIR="/run/user/$user_uid" pw-metadata -n settings 0 clock.force-rate "$rate" >/dev/null 2>&1
    confirm "PipeWire Target Sample Rate -> $rate Hz"
}

# SCX Scheduler
start_scheduler() {
    local sched=${SCHED_NAME:-lavd}
    local mode=${SCHED_MODE:-lowlatency}

    if command -v scxctl &>/dev/null; then
        scxctl stop >/dev/null 2>&1
        sleep 0.2
        scxctl start --sched "$sched" --mode "$mode" &
        confirm "Scheduler started -> $sched (Mode: $mode)"
    else
        echo -e "${RED}SCX Scheduler (scxctl) not found in PATH!${NC}"
    fi
}

# Restore defaults
revert_defaults() {
    notify "Restoring system defaults..."

    # 1. Standard Governors & States
    manage_cpu off
    manage_wifi off
    manage_usb off
    manage_pipewire off
    manage_gpu off
    manage_bluetooth off
    manage_thp off

    # 2. Sound IRQ Specific Revert
    # We target the same threads found in manage_pipewire
    local sound_irqs=$(pgrep -f "snd_hda_intel|snd_acp")
    for pid in $sound_irqs; do
        chrt -o -p 0 "$pid" >/dev/null 2>&1
    done

    # 3. Scheduler Cleanup
    if command -v scxctl &>/dev/null; then
        scxctl stop >/dev/null 2>&1
        confirm "SCX Scheduler stopped"
    fi

    notify "System defaults restored (Sound IRQs reset to standard priority)"
}

# --------------------------
# VERBOSE HELP FUNCTION (-h)
# --------------------------
show_help() {
    echo -e "${YLW}Linux Gamemode Enhanced (High-Performance Audio & Gaming Wrapper)${NC}"
    echo -e "----------------------------------------------------------------------"
    echo -e "This script forcibly overrides system parameters to prioritize low-latency"
    echo -e "audio processing, controller polling, and raw GPU performance. It interacts"
    echo -e "directly with hardware governors, process scheduling, and PipeWire APIs."

    echo -e "\n${GRN}USAGE:${NC} sudo $0 [OPTIONS]"

    echo -e "\n${CYN}CORE OPTIONS:${NC}"
    echo -e "  ${YLW}-q <quantum>${NC}    Forces the PipeWire buffer quantum size. Lower values (e.g., 64, 128)"
    echo -e "                 decrease audio latency but increase CPU load. (Default: ${DEFAULT_QUANTUM})"
    echo -e "  ${YLW}-r <rate>${NC}       Forces the PipeWire sample rate. Ensures no resampling occurs"
    echo -e "                 if matching your game/audio-interface. (Default: ${DEFAULT_RATE} Hz)"
    echo -e "  ${YLW}-s <scheduler>${NC}  Injects a custom eBPF scheduler via SCX. Overrides the default"
    echo -e "                 CFS scheduler in the Linux Kernel. (Default: lavd)"
    echo -e "  ${YLW}-m <mode>${NC}       Applies a specific behavioral profile to the chosen SCX scheduler."
    echo -e "                 (Default: lowlatency)"
    echo -e "  ${YLW}-i${NC}             Displays current Audio settings, sample rates, and an"
    echo -e "                 active hardware Interrupt Request (IRQ) thread breakdown."
    echo -e "  ${YLW}-x${NC}             Restores all hardware governors, schedulers, and powersave states."
    echo -e "  ${YLW}-h${NC}             Shows this verbose help message."

    echo -e "\n${YLW}--- BEHAVIORAL MECHANICS ---${NC}"
    echo -e "  ${GRN}Service Restarts:${NC} Passing -q or -r explicitly stops and restarts all PipeWire"
    echo -e "                    user services safely using the calling user's DBus/systemd context,"
    echo -e "                    ensuring zombie audio graphs don't crash games."
    echo -e "  ${GRN}RT IRQs:${NC}          This script injects Real-Time (FIFO) priority to critical hardware"
    echo -e "                    polling threads (USB XHCI for controllers, PipeWire, Bluetooth)."

    echo -e "\n${YLW}--- SCX Schedulers (eBPF) ---${NC}"
    echo -e "  * ${GRN}beerland${NC}   - High-throughput, heavy compilation/IO tasks."
    echo -e "  * ${GRN}bpfland${NC}    - Direct BPF, minimal scheduling overhead."
    echo -e "  * ${GRN}cosmos${NC}     - High-performance general-purpose."
    echo -e "  * ${GRN}flash${NC}      - Ultra-aggressive preemption. Maximum responsiveness, low efficiency."
    echo -e "  * ${GRN}lavd${NC}       - Latency-critical Auto-Vblank (Best for Audio)."
    echo -e "  * ${GRN}p2dq${NC}       - Power-aware Dual Queue (Balanced laptops)."
    echo -e "  * ${GRN}rustland${NC}   - High-safety BPF written in Rust."
    echo -e "  * ${GRN}rusty${NC}      - Efficient modern scheduler for highly interactive multicore desktop use."
    echo -e "  * ${GRN}tickless${NC}   - Reduced timer interrupts for CPU consistency."

    echo -e "\n${YLW}--- Supported Mode Profiles ---${NC}"
    echo -e "  * ${CYN}gaming${NC}     - Prioritizes foreground task vblank sync to prevent stutter."
    echo -e "  * ${CYN}lowlatency${NC} - Favors absolute lowest scheduling delay for RT audio apps."
    echo -e "  * ${CYN}powersave${NC}  - Efficient, battery-friendly mode."
    echo -e "  * ${CYN}balanced${NC}   - Standard desktop responsiveness."

    echo -e "\n${YLW}--- GPU Setup Options (Editable in config) ---${NC}"
    echo -e "  * ${CYN}nvidia${NC}         - Dedicated NVIDIA GPU"
    echo -e "  * ${CYN}nvidia_hybrid${NC}  - NVIDIA + Integrated GPU (Hybrid)"
    echo -e "  * ${CYN}nvidia_nvk${NC}     - NVIDIA with FOSS driver (Nouveau)"
    echo -e "  * ${CYN}amd${NC}            - Dedicated AMD GPU"
    echo -e "  * ${CYN}intel${NC}          - Integrated Intel GPU"

    echo -e "\n${YLW}--- RT Priority Defaults (Editable in config) ---${NC}"
    echo -e "  USB       : ${CYN}$RT_PRIO_USB${NC}"
    echo -e "  PipeWire  : ${CYN}$RT_PRIO_PIPEWIRE${NC}"
    echo -e "  Bluetooth : ${CYN}$RT_PRIO_BT${NC}"
    echo -e "  Sound IRQ : ${CYN}$RT_PRIO_SOUND${NC}"

    echo -e "----------------------------------------------------------------------"
    exit 0
}

# --------------------------
# MAIN OPTIONS PARSING
# --------------------------
[[ $EUID -ne 0 ]] && { echo -e "${RED}ERROR: Script must be executed with sudo privileges.${NC}"; exit 1; }

while getopts "q:r:s:m:ixh" opt; do
    case "$opt" in
        q) QUANTUM=$OPTARG ;;
        r) RATE=$OPTARG ;;
        s) SCHED_NAME=$OPTARG ;;
        m) SCHED_MODE=$OPTARG ;;
        i) display_status ;;
        x) revert_defaults; exit 0 ;;
        h) show_help ;;
        *) show_help ;;
    esac
done

# --------------------------
# ACTIVATE PERFORMANCE MODE
# --------------------------
notify "Engaging Linux Audio & Gaming Performance Mode..."
manage_thp on
manage_cpu on
manage_wifi on
manage_usb on
manage_pipewire on
manage_gpu on
manage_bluetooth on
set_pipewire_audio "$QUANTUM" "$RATE"
start_scheduler
notify "System Performance Mode -> ACTIVE"
